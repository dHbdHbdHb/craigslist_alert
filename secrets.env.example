# ==============================================================================
#  secrets.env.example — copy to `secrets.env` and fill in your own values.
# ==============================================================================
#
#   cp secrets.env.example secrets.env
#
# `secrets.env` is gitignored and must NEVER be committed. Everything in here is
# shared across all profiles — the same Gmail account sends every profile's mail,
# and the same routing key computes every profile's bike times. Per-person
# settings (recipients, budget, neighborhoods) live in profiles/*.toml instead.
#
# Format is plain KEY=VALUE. Quotes are optional and stripped. Lines starting
# with # are ignored.

# The Gmail account that SENDS alerts. Not the account that receives them —
# recipients are configured per profile.
GMAIL_ADDRESS=you@gmail.com

# A Gmail *app password*, not your account password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OpenRouteService key, used to compute cycling times to transit stations.
# Free tier is 40 requests/minute, 2000/day — plenty for two profiles.
# Generate one at https://account.heigit.org/manage/key
ORS_API_KEY=your-openrouteservice-key
